# Copy this file to .env.local and adjust values as needed

# OAuth2 Configuration
NEXT_PUBLIC_AUTH_ENDPOINT=http://idp:9000/oauth2/authorize
NEXT_PUBLIC_TOKEN_ENDPOINT=http://idp:9000/oauth2/token
NEXT_PUBLIC_USERINFO_ENDPOINT=http://idp:9000/userinfo
NEXT_PUBLIC_CLIENT_ID=public-client
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/callback
